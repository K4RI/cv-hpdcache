n CLK
i hpdcache_wrapper.clk_i

n CORE_REQ
i hpdcache_wrapper.core_req_valid_i
o hpdcache_wrapper.core_req_ready_o
d core_req_i.op
- 0 Read
- 1 Write
d core_req_i.wdata[0]
- 0 NoData
- 1 D1
- 2 D2
- 3 D3
d core_req_i.sid
d core_req_i.tid
d core_req_i.addr_tag
- 1 A1
- 2 A2
- 3 A3

n CORE_RSP
o hpdcache_wrapper.core_rsp_valid_o
d core_rsp_o.rdata[0]
- 0 NoData
- 1 D1
- 2 D2
- 3 D3
d core_rsp_o.sid
d core_rsp_o.tid
